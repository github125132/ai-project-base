# 环境变量示例
# AI 初始化时从本模板复制为 .env,替换 gap 令牌;敏感字段提示用户填写
# .env 不得提交

# ===== 内网 Git =====
GIT_INTERNAL_HOST=<内网Git主机:端口>
GIT_INTERNAL_USER=<内网Git账号>
GIT_USER_NAME=<提交人姓名>
GIT_USER_EMAIL=<提交人邮箱>

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gap
MYSQL_USERNAME=<数据库账号>
MYSQL_PASSWORD=<数据库强密码>

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ===== 后端 =====
SERVER_PORT=48080
SPRING_PROFILES_ACTIVE=local
